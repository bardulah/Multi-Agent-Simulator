{
  "manifest_version": 3,
  "name": "Marketplace Description Generator",
  "version": "1.0.0",
  "description": "AI-powered description generator for eBay, Vinted, Kleinanzeigen using Prompt Mutation Framework",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ebay.de/*",
    "https://www.ebay.com/*",
    "https://www.vinted.de/*",
    "https://www.vinted.fr/*",
    "https://www.kleinanzeigen.de/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.de/sl/sell*",
        "https://www.ebay.com/sl/sell*",
        "https://www.vinted.de/items/new*",
        "https://www.vinted.fr/items/new*",
        "https://www.kleinanzeigen.de/p-anzeige-aufgeben*"
      ],
      "js": ["content.js"],
      "css": ["content-styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
